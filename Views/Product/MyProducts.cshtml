@model IEnumerable<Product>
@inject Fauzora.Services.SecureIdService SecureIds
@{ ViewData["Title"] = "Produk Saya"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Produk Saya</h2>
    <a asp-action="Create" class="btn btn-primary">Tambah Produk</a>
</div>
<form asp-action="MyProducts" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3 product-category-filter">
    <div>
        <label for="categoryId" class="form-label small mb-1">Filter kategori</label>
        <select id="categoryId" name="categoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">Semua kategori</option>
        </select>
    </div>
    <button class="btn btn-outline-primary">Terapkan</button>
    @if (ViewBag.SelectedCategoryId is not null)
    {
        <a asp-action="MyProducts" class="btn btn-outline-secondary">Reset</a>
    }
</form>
@if (!Model.Any())
{
    <div class="empty-state">
        @if (ViewBag.SelectedCategoryId is not null)
        {
            <span>Belum ada produk pada kategori ini. Coba pilih kategori lain atau reset filter.</span>
        }
        else
        {
            <span>Belum ada produk. Klik <strong>Tambah Produk</strong> untuk memulai.</span>
        }
    </div>
}
else
{
    <div class="table-card table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Nama</th><th>Kategori</th><th>Harga</th><th>Stok</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Name</td>
                        <td>@p.Category?.Name</td>
                        <td>@p.Price.ToRupiah()</td>
                        <td>@p.Stock</td>
                        <td><span class="badge @(p.IsActive ? "text-bg-success" : "text-bg-secondary")">@(p.IsActive ? "Aktif" : "Nonaktif")</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@SecureIds.Protect(p.Id)" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" data-swal-confirm data-swal-title="Hapus produk ini?" data-swal-text="Produk yang dihapus tidak dapat dikembalikan." data-swal-confirm-text="Ya, hapus" data-swal-icon="warning">
                                <button class="btn btn-sm btn-outline-danger">Hapus</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
