@model ResetPasswordVm
@{ ViewData["Title"] = "Reset Password"; }
<div class="auth-card">
    <h1 class="auth-title">Buat Password Baru</h1>
    <form asp-action="ResetPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div class="form-floating mb-2">
            <input asp-for="Password" class="form-control" placeholder="Password baru" autocomplete="new-password" />
            <label asp-for="Password"></label>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="ConfirmPassword" class="form-control" placeholder="Konfirmasi password" autocomplete="new-password" />
            <label asp-for="ConfirmPassword"></label>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100">Simpan Password Baru</button>
    </form>
</div>
