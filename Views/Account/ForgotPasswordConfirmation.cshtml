@{ ViewData["Title"] = "Cek Email"; }
<div class="auth-card">
    <h1 class="auth-title">Permintaan Diproses</h1>
    <p class="text-muted small">Jika email tersebut terdaftar dan sudah dikonfirmasi, link reset password telah dibuat.</p>
    @if (TempData["ResetLink"] is string resetLink)
    {
        <div class="alert alert-info small" role="alert">
            Mode lokal: gunakan link berikut untuk mengatur password baru.
            <a href="@resetLink" class="d-block mt-2 text-break">@resetLink</a>
        </div>
    }
    <a class="btn btn-primary w-100" asp-action="Login">Kembali ke Login</a>
</div>
