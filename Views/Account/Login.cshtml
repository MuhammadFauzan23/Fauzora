@model LoginVm
@{ ViewData["Title"] = "Login"; }
<div class="auth-page">
    <div class="auth-shell">
        <section class="auth-intro">
            <img src="~/img/logo.svg" alt="Logo Fauzora" class="auth-logo" />
            <p class="auth-kicker">Marketplace pilihanmu</p>
            <h1>Welcome to Fauzora</h1>
            <p>Temukan produk favorit, belanja dengan nyaman, dan nikmati pengalaman marketplace yang lebih sederhana.</p>
        </section>
        <section class="auth-card">
            <h2 class="auth-title">Login ke akunmu</h2>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="form-floating mb-2">
            <input asp-for="Email" class="form-control" placeholder="Email" autocomplete="username" />
            <label asp-for="Email"></label>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="form-floating mb-3">
            <input asp-for="Password" class="form-control" placeholder="Password" autocomplete="current-password" />
            <label asp-for="Password"></label>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label small"></label>
        </div>
        <button class="btn btn-primary w-100">Login</button>
    </form>
    <p class="text-center small mt-3 mb-0"><a asp-action="ForgotPassword">Lupa password?</a></p>
    <p class="auth-switch">Belum punya akun? <a asp-action="Register">Buat akun</a></p>
        </section>
    </div>
</div>
