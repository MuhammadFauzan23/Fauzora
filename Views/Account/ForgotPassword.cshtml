@model ForgotPasswordVm
@{ ViewData["Title"] = "Lupa Password"; }
<div class="auth-card">
    <h1 class="auth-title">Lupa Password</h1>
    <p class="text-muted small text-center mb-4">Masukkan email akun untuk mendapatkan link pengaturan password baru.</p>
    <form asp-action="ForgotPassword" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" placeholder="Email" autocomplete="email" />
            <label asp-for="Email">Email</label>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100">Kirim Link Reset</button>
    </form>
    <p class="auth-switch"><a asp-action="Login">Kembali ke Login</a></p>
</div>
